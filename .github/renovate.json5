{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "dependencyDashboard": false,
  "labels": ["Dependencies"],
  "semanticCommits": "enabled",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
    },
    {
      // CodeQL's Kotlin extractor rejects Kotlin >= 2.4.20 ("version is too
      // recent", CLI 2.26.4), which fails the java-kotlin CodeQL build. Hold
      // Kotlin at 2.4.10 until a CodeQL CLI with 2.4.20 support reaches the
      // GitHub runners, then drop this rule. See github/codeql "Support
      // Kotlin 2.4.20".
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin(\\.|:|$)/"],
      "allowedVersions": "<2.4.20",
    },
    {
      // moko-resources 0.27.0 stops exposing some i18n strings to consuming
      // modules (core:main fails: "Unresolved reference 'webview_is_required'"
      // etc.). Hold at 0.26.x until the cross-module resource regression is
      // sorted out, then drop this rule.
      "matchPackageNames": [
        "dev.icerock.moko:resources",
        "dev.icerock.moko:resources-compose",
        "dev.icerock.mobile.multiplatform-resources",
      ],
      "allowedVersions": "<0.27.0",
    },
    {
      // These are JitPack forks/custom builds pinned to a specific commit or
      // tag rather than a real release, so Renovate can't resolve/compare
      // versions for them -- keep it from trying (and failing) to look them up.
      "matchPackageNames": [
        "com.github.arkon.FlexibleAdapter:flexible-adapter-ui",
        "com.github.arkon.FlexibleAdapter:flexible-adapter",
        "com.github.CarlosEsco:ViewTooltip",
        "com.github.null2264:subsampling-scale-image-view",
        "com.github.null2264:injekt-koin",
        "com.github.tachiyomiorg:image-decoder",
        "com.github.tachiyomiorg:unifile",
        "com.github.tachiyomiorg:conductor-support-preference",
        "com.github.chrisbanes:PhotoView",
        "com.github.PhilJay:MPAndroidChart",
      ],
      "enabled": false,
    },
  ],
}
